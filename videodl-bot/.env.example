TELEGRAM_BOT_API_KEY=replace-with-botfather-token
TELEGRAM_ALLOWED_USER_ID=123456789

# Non-root runtime identity; match the owner of both host directories.
PUID=1000
PGID=1000
# Existing writable host directories; relative paths use this stack's directory.
VIDEODL_DOWNLOADS_PATH=./downloads
VIDEODL_STATE_PATH=./state

QUEUE_MAX_PENDING=20
MAX_DURATION_SECONDS=7200
MAX_FILE_BYTES=4294967296
FREE_SPACE_RESERVE_BYTES=2147483648
JOB_DEADLINE_MS=3600000
