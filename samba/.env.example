# Copy to .env and set the host paths and credentials for this stack.
# Relative paths resolve beside docker-compose.yml.
# Replace password placeholders; single quotes preserve literal $ and # characters.
# Avoid semicolons and double quotes in credentials (Samba command delimiters).

SAMBA_SHARE_PATH=/home/user/downloads
SAMBA_USER=samba
SAMBA_PASSWORD='replace-with-a-strong-password'
