# Set the host interface address for LAN access; loopback allows local access only.
BIND_IP=127.0.0.1
# Browser-facing origin(s), comma-separated; use the actual hostname or IP and port.
APP_ORIGINS=http://127.0.0.1:8082
ATHLETE_TIMEZONE=Europe/Rome
GARMIN_API_KEY=
LOG_LEVEL=info
GARMIN_REQUEST_INTERVAL_MS=1000
