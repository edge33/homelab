# Use id -u and id -g on the deployment host.
HERMES_UID=1000
HERMES_GID=1000
# Listen on all host IPv4 interfaces for LAN access; use 127.0.0.1 for local-only.
HERMES_BIND_IP=0.0.0.0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Generate separate values with openssl rand -hex 32.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
